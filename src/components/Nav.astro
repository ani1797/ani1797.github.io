---
import site from "../content/site.json";

const searchable = [
  ...site.nav.map((n) => ({ label: n.label, href: n.href })),
  { label: "GitHub", href: site.social.github },
  { label: "LinkedIn", href: site.social.linkedin },
  { label: site.resume.label, href: site.resume.href },
];
---

<nav class="w-full sticky top-0 z-50 bg-background/90 backdrop-blur-sm border-b border-outline-variant">
  <div class="flex justify-between items-center h-16 px-4 sm:px-6 max-w-screen-xl mx-auto">
    <a href="#top" class="font-bold text-lg text-on-surface flex items-center gap-2">
      <img src={site.logo} alt="AA monogram" class="h-8 w-auto" />
      <span class="tracking-tight">{site.shortName}</span>
    </a>

    <div class="hidden md:flex items-center gap-6 font-mono text-sm">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="text-on-surface-variant hover:text-primary transition-colors pb-1"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <a
        href={site.resume.href}
        download
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 border border-outline-variant rounded font-mono text-xs text-on-surface-variant hover:border-secondary hover:text-secondary transition-colors"
      >
        {site.resume.label}
      </a>
      <button
        id="palette-trigger"
        type="button"
        aria-label="Open command palette"
        class="hidden md:flex items-center gap-2 px-3 py-1.5 border border-outline-variant rounded bg-surface-container-low text-on-surface-variant font-mono text-xs cursor-pointer hover:border-primary transition-colors"
      >
        <span>Search</span>
        <span class="opacity-50">⌘K</span>
      </button>
      <div class="flex items-center gap-2">
        <a
          aria-label="GitHub"
          href={site.social.github}
          target="_blank"
          rel="noreferrer"
          class="p-2 hover:bg-surface-container-high rounded transition-colors text-on-surface-variant hover:text-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        </a>
        <a
          aria-label="LinkedIn"
          href={site.social.linkedin}
          target="_blank"
          rel="noreferrer"
          class="p-2 hover:bg-surface-container-high rounded transition-colors text-on-surface-variant hover:text-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Command palette dialog -->
  <div
    id="command-palette"
    class="hidden fixed inset-0 z-[60] items-start justify-center pt-24 bg-black/60 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
  >
    <div class="w-full max-w-lg mx-4 rounded-lg border border-outline-variant bg-surface-container-lowest shadow-2xl overflow-hidden">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-outline-variant">
        <span class="text-on-surface-variant font-mono text-sm">{'>'}</span>
        <input
          id="palette-input"
          type="text"
          placeholder="Jump to a section or link..."
          class="w-full bg-transparent outline-none font-mono text-sm text-on-surface placeholder:text-on-surface-variant"
        />
        <kbd class="text-xs text-on-surface-variant border border-outline-variant rounded px-1.5 py-0.5">Esc</kbd>
      </div>
      <ul id="palette-results" class="max-h-72 overflow-y-auto py-2">
        {searchable.map((item) => (
          <li>
            <a
              href={item.href}
              data-label={item.label.toLowerCase()}
              class="palette-item flex items-center justify-between px-4 py-2 font-mono text-sm text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-colors"
            >
              <span>{item.label}</span>
              <span class="opacity-40 text-xs">↵</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  const trigger = document.getElementById("palette-trigger");
  const palette = document.getElementById("command-palette");
  const input = document.getElementById("palette-input") as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>(".palette-item"));

  const openPalette = () => {
    palette?.classList.remove("hidden");
    palette?.classList.add("flex");
    input?.focus();
  };

  const closePalette = () => {
    palette?.classList.add("hidden");
    palette?.classList.remove("flex");
    if (input) input.value = "";
    items.forEach((item) => (item.style.display = ""));
  };

  trigger?.addEventListener("click", openPalette);

  palette?.addEventListener("click", (e) => {
    if (e.target === palette) closePalette();
  });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      openPalette();
    }
    if (e.key === "Escape") closePalette();
  });

  input?.addEventListener("input", () => {
    const query = input.value.toLowerCase();
    items.forEach((item) => {
      const match = item.dataset.label?.includes(query);
      item.style.display = match ? "" : "none";
    });
  });
</script>
