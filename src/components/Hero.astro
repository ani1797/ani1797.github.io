---
import hero from "../content/hero.json";

const syntaxClass: Record<string, string> = {
  def: "text-primary",
  plain: "text-on-surface-variant",
  blank: "",
};
---

<section id="top" class="min-h-[calc(100vh-4rem)] flex flex-col">
  <div class="flex-grow flex flex-col justify-center py-12 md:py-16">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">
        <div class="lg:col-span-8 flex flex-col gap-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-surface-container-low border border-outline-variant w-fit">
            <div class="w-2 h-2 rounded-full bg-secondary animate-pulse"></div>
            <span class="font-mono text-xs text-secondary">{hero.status}</span>
          </div>

          <h1 class="text-[40px] leading-[1.1] md:text-[64px] font-bold text-on-surface tracking-tight">
            {hero.headline}
          </h1>

          <h2 class="font-mono text-base md:text-lg text-primary max-w-2xl">
            &gt; {hero.typedLine}<span
              class="blink inline-block w-[8px] h-[18px] bg-secondary align-middle ml-1"
              aria-hidden="true"></span>
          </h2>

          <p class="text-on-surface-variant max-w-2xl leading-relaxed">{hero.bio}</p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={hero.primaryCta.href}
              class="px-6 py-3 bg-primary text-on-primary-container font-mono text-sm font-bold rounded hover:opacity-90 transition-opacity flex items-center gap-2 active:scale-[0.98]"
            >
              {hero.primaryCta.label}
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={hero.secondaryCta.href}
              class="px-6 py-3 border border-outline-variant text-on-surface font-mono text-sm rounded hover:bg-surface-container-high hover:border-primary transition-all flex items-center gap-2 active:scale-[0.98]"
            >
              {hero.secondaryCta.label}
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 hidden lg:block">
          <div class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden shadow-2xl">
            <div class="flex items-center gap-2 px-4 py-2 border-b border-outline-variant bg-surface-container-low">
              <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-secondary/70"></div>
              <span class="ml-4 font-mono text-xs text-on-surface-variant">{hero.codePanel.filename}</span>
            </div>
            <div class="p-4 font-mono text-xs overflow-x-auto text-on-surface-variant">
              <pre class="leading-relaxed">{hero.codePanel.lines.map((line) => (
                <span class={syntaxClass[line.kind] ?? ""}>{line.text}
</span>
              ))}</pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="w-full border-t border-outline-variant bg-surface-container-lowest/60">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap gap-x-8 gap-y-2 items-center font-mono text-xs text-on-surface-variant">
      {hero.telemetry.map((item) => (
        <div class="flex items-center gap-2">
          <span class="text-secondary" aria-hidden="true">●</span>
          <span>{item.label}: <span class="text-on-surface">{item.value}</span></span>
        </div>
      ))}
    </div>
  </div>
</section>
