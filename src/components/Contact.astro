---
import contact from "../content/contact.json";
---

<section id="contact" class="min-h-[calc(100vh-4rem-3.25rem)] flex flex-col justify-center py-16 md:py-24 border-t border-outline-variant">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-on-surface mb-6">{contact.heading}</h2>

    <div class="font-mono text-sm text-secondary bg-surface-container-low border border-outline-variant rounded px-4 py-3 w-fit mb-10">
      {contact.prompt}<span
        class="blink inline-block w-[8px] h-[16px] bg-secondary align-middle ml-1"
        aria-hidden="true"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-3xl">
      {contact.cards.map((card) => (
        <a
          href={card.href}
          target="_blank"
          rel="noreferrer"
          class="group flex items-center justify-between rounded-lg border border-outline-variant bg-surface-container-low p-5 transition-all hover:border-secondary hover:shadow-[0_0_20px_-4px_theme(colors.secondary)]"
        >
          <div>
            <p class="font-mono text-xs text-on-surface-variant">{card.label}</p>
            <p class="font-mono text-sm text-on-surface">{card.value}</p>
          </div>
          <span class="text-secondary transition-transform group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </a>
      ))}
      <a
        href={contact.cta.href}
        class="flex items-center justify-center rounded-lg bg-primary text-on-primary-container font-mono text-sm font-bold p-5 transition-opacity hover:opacity-90 active:scale-[0.98]"
      >
        {contact.cta.label}
      </a>
    </div>
  </div>
</section>
